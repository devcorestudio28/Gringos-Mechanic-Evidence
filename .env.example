DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_GUILD_ID=your_server_id
DATABASE_URL=mysql://user:password@host:3306/mechanic_tracker

# Discord role IDs allowed to use each action. Separate multiple IDs with commas.
REPAIR_ROLE_IDS=role_id_1,role_id_2
RESET_ROLE_IDS=role_id_1
PAYOUT_ROLE_IDS=role_id_1,role_id_2
DESKTOP_API_KEY=replace_with_a_long_random_secret
DESKTOP_REDIRECT_URI=https://your-northflank-host/auth/callback

# Optional: channel IDs for the repair and payout boards. Leave blank to post them
# in the channel where /post-panels is run.
REPAIR_CHANNEL_ID=
PAYOUT_CHANNEL_ID=
REPAIR_RATE=1650
TIMEZONE=Europe/Zagreb
PORT=3210
